[
  {
    "id": "workflow-search-cycle",
    "name": "JP - Search Cycle Orchestration",
    "active": false,
    "nodes": [
      {
        "parameters": {},
        "id": "node-trigger",
        "name": "Start",
        "type": "n8n-nodes-base.manualTrigger",
        "typeVersion": 1,
        "position": [100, 300]
      },
      {
        "parameters": {},
        "id": "node-loop",
        "name": "Loop",
        "type": "n8n-nodes-base.loop",
        "typeVersion": 1,
        "position": [300, 300]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://fastapi:8000/ingestion/internal/select-next",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={ \"cycle_id\": \"{{ $execution.id }}\" }"
        },
        "id": "node-select",
        "name": "Select Next",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.1,
        "position": [500, 300],
        "credentials": {
          "httpHeaderAuth": {
            "id": "T0w0H2O4M9E6W4T6",
            "name": "JP - FastAPI Internal API"
          }
        }
      },
      {
        "parameters": {
          "conditions": {
            "options": {"caseSensitive": true, "typeValidation": "strict"},
            "conditions": [
              {
                "leftValue": "={{ $json.action }}",
                "rightValue": "execute",
                "operator": {"type": "string", "operation": "equals"}
              }
            ],
            "combinator": "and"
          }
        },
        "id": "node-action-check",
        "name": "Action Check",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [700, 300]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://fastapi:8000/ingestion/internal/search",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify($json.intent) }}"
        },
        "id": "node-execute",
        "name": "Execute",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.1,
        "position": [900, 200],
        "credentials": {
          "httpHeaderAuth": {
            "id": "T0w0H2O4M9E6W4T6",
            "name": "JP - FastAPI Internal API"
          }
        },
        "continueOnFail": true
      },
      {
        "parameters": {
          "jsCode": "return { json: { status: 'Cycle stopped', reason: $input.first().json.reason } };"
        },
        "id": "node-stop",
        "name": "Stop",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [900, 400]
      }
    ],
    "connections": {
      "Start": {"main": [[{"node": "Loop", "type": "main", "index": 0}]]},
      "Loop": {"main": [[{"node": "Select Next", "type": "main", "index": 0}], []]},
      "Select Next": {"main": [[{"node": "Action Check", "type": "main", "index": 0}]]},
      "Action Check": {"main": [[{"node": "Execute", "type": "main", "index": 0}], [{"node": "Stop", "type": "main", "index": 0}]]},
      "Execute": {"main": [[{"node": "Loop", "type": "main", "index": 0}]]},
      "Stop": {"main": [[]]}
    }
  }
]
