[
  {
    "id": "workflow-notifications",
    "name": "JP - Notifications Delivery",
    "active": false,
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "hours",
                "hoursInterval": 4
              }
            ]
          }
        },
        "id": "node-trigger",
        "name": "Schedule",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1,
        "position": [
          100,
          300
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://fastapi:8000/ingestion/internal/notifications/recover-stale",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={ \"stale_minutes\": 30 }"
        },
        "id": "node-recover-stale",
        "name": "Recover Stale Claims",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.1,
        "position": [
          250,
          300
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "T0w0H2O4M9E6W4T6",
            "name": "JP - FastAPI Internal API"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 2000
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://fastapi:8000/ingestion/internal/notifications/claim",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={ \"delivery_id\": \"{{ $execution.id }}\", \"limit\": 5 }"
        },
        "id": "node-claim",
        "name": "Claim Notifications",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.1,
        "position": [
          400,
          300
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "T0w0H2O4M9E6W4T6",
            "name": "JP - FastAPI Internal API"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 2000
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "typeValidation": "strict",
              "version": 2,
              "leftValue": ""
            },
            "conditions": [
              {
                "id": "5963282b-6f77-4c07-b3ab-b84555800040",
                "leftValue": "={{ $json.recommendations.length }}",
                "rightValue": 0,
                "operator": {
                  "type": "number",
                  "operation": "gt"
                }
              }
            ],
            "combinator": "and"
          }
        },
        "id": "node-check-empty",
        "name": "Check If Empty",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          500,
          300
        ]
      },
      {
        "parameters": {
          "jsCode": "const recs = $input.first().json.recommendations;\nconst escapeHtml = (unsafe) => {\n    return String(unsafe)\n         .replace(/&/g, \"&amp;\")\n         .replace(/</g, \"&lt;\")\n         .replace(/>/g, \"&gt;\")\n         .replace(/\"/g, \"&quot;\")\n         .replace(/'/g, \"&#039;\");\n};\nlet msg = \"\ud83d\ude80 <b>New Job Matches</b>\\n\\n\";\nrecs.forEach((job, idx) => {\n  const safeUrl = escapeHtml(encodeURI(job.url || \"\"));\n  const safeTitle = escapeHtml(job.title);\n  const safeCompany = escapeHtml(job.company);\n  msg += `${idx + 1}. <a href=\"${safeUrl}\">${safeTitle}</a>\\n`;\n  msg += `\ud83c\udfe2 ${safeCompany}\\n`;\n  if (job.location) msg += `\ud83d\udccd ${escapeHtml(job.location)}\\n`;\n  msg += `\\n`;\n});\nreturn { json: { message: msg, user_id: $input.first().json.user_id, delivery_id: $input.first().json.delivery_id } };"
        },
        "id": "node-format",
        "name": "Format Payload",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          700,
          200
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://fastapi:8000/ingestion/internal/notifications/send-start",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={ \"user_id\": {{ $('Claim Notifications').item.json.user_id }}, \"delivery_id\": \"{{ $('Claim Notifications').item.json.delivery_id }}\" }"
        },
        "id": "node-send-start",
        "name": "Mark Send Started",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.1,
        "position": [
          900,
          200
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "T0w0H2O4M9E6W4T6",
            "name": "JP - FastAPI Internal API"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 2000
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "typeValidation": "strict",
              "version": 2,
              "leftValue": ""
            },
            "conditions": [
              {
                "id": "e4f8b056-b8a7-47be-bdf1-30ec8b88d3d9",
                "leftValue": "={{ $json.authorized }}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "equals"
                }
              }
            ],
            "combinator": "and"
          }
        },
        "id": "node-check-send-authorized",
        "name": "Check Send Authorized",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          1050,
          200
        ]
      },
      {
        "parameters": {
          "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
          "text": "={{ $('Format Payload').item.json.message }}",
          "additionalFields": {
            "parse_mode": "HTML"
          }
        },
        "id": "node-telegram",
        "name": "Send Telegram",
        "type": "n8n-nodes-base.telegram",
        "typeVersion": 1,
        "position": [
          1100,
          200
        ],
        "credentials": {
          "telegramApi": {
            "id": "telegram_bot",
            "name": "Telegram Bot"
          }
        },
        "onError": "continueErrorOutput"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://fastapi:8000/ingestion/internal/notifications/acknowledge",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={ \"user_id\": {{ $('Claim Notifications').item.json.user_id }}, \"delivery_id\": \"{{ $('Claim Notifications').item.json.delivery_id }}\" }"
        },
        "id": "node-acknowledge",
        "name": "Acknowledge Delivery",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.1,
        "position": [
          1300,
          200
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "T0w0H2O4M9E6W4T6",
            "name": "JP - FastAPI Internal API"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 2000
      },
      {
        "parameters": {
          "jsCode": "if ($input.first().json.acknowledged !== true) {\n  throw new Error(\"Acknowledgement semantically failed: acknowledged=false\");\n}\nreturn $input.all();"
        },
        "id": "node-verify-ack",
        "name": "Verify Acknowledgement",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1500,
          200
        ]
      },
      {
        "parameters": {
          "jsCode": "const item = $input.first().json;\nconst err = item.error || {};\nconst httpCode = String(err.httpCode || err.statusCode || \"\");\nconst msg = String(err.message || item.message || \"\");\nconst isDefinitive = (httpCode === \"400\" || httpCode === \"403\" || msg.includes(\"400\") || msg.includes(\"403\") || msg.includes(\"Bad Request\") || msg.includes(\"Forbidden\") || msg.includes(\"bot was blocked\"));\nif (!isDefinitive) {\n  return [];\n}\nreturn [{ json: { definitive: true, reason: msg || \"Telegram definitive send rejection\" } }];"
        },
        "id": "node-definitive-check",
        "name": "Definitive Failure Check",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1300,
          350
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://fastapi:8000/ingestion/internal/notifications/fail",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={ \"user_id\": {{ $('Claim Notifications').item.json.user_id }}, \"delivery_id\": \"{{ $('Claim Notifications').item.json.delivery_id }}\", \"reason\": \"{{ $json.reason || 'Telegram definitive send rejection' }}\", \"definitive\": true }"
        },
        "id": "node-fail-delivery",
        "name": "Fail Delivery",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.1,
        "position": [
          1500,
          350
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "T0w0H2O4M9E6W4T6",
            "name": "JP - FastAPI Internal API"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 2000
      }
    ],
    "connections": {
      "Schedule": {
        "main": [
          [
            {
              "node": "Recover Stale Claims",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Recover Stale Claims": {
        "main": [
          [
            {
              "node": "Claim Notifications",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Claim Notifications": {
        "main": [
          [
            {
              "node": "Check If Empty",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Check If Empty": {
        "main": [
          [
            {
              "node": "Format Payload",
              "type": "main",
              "index": 0
            }
          ],
          []
        ]
      },
      "Format Payload": {
        "main": [
          [
            {
              "node": "Mark Send Started",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Mark Send Started": {
        "main": [
          [
            {
              "node": "Check Send Authorized",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Check Send Authorized": {
        "main": [
          [
            {
              "node": "Send Telegram",
              "type": "main",
              "index": 0
            }
          ],
          []
        ]
      },
      "Send Telegram": {
        "main": [
          [
            {
              "node": "Acknowledge Delivery",
              "type": "main",
              "index": 0
            }
          ],
          [
            {
              "node": "Definitive Failure Check",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Definitive Failure Check": {
        "main": [
          [
            {
              "node": "Fail Delivery",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Fail Delivery": {
        "main": [
          []
        ]
      },
      "Acknowledge Delivery": {
        "main": [
          [
            {
              "node": "Verify Acknowledgement",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    }
  }
]