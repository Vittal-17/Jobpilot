# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm AS builder

# Prevent Python from writing .pyc files
ENV PYTHONDONTWRITEBYTECODE=1
# Ensure output is sent straight to terminal
ENV PYTHONUNBUFFERED=1

WORKDIR /build

COPY requirements.lock .
RUN pip install --no-cache-dir -r requirements.lock

FROM python:3.12-slim-bookworm AS runtime

ARG APP_COMMIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

# OCI Labels
LABEL org.opencontainers.image.title="JobPilot FastAPI Backend"
LABEL org.opencontainers.image.description="Job Intelligence API for JobPilot"
LABEL org.opencontainers.image.revision="${APP_COMMIT_SHA}"
LABEL org.opencontainers.image.created="${BUILD_TIMESTAMP}"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV ENVIRONMENT=production
ENV PYTHONPATH=/app
ENV APP_COMMIT_SHA=${APP_COMMIT_SHA}

# Create a non-root user
RUN groupadd -g 10001 jobpilot && \
    useradd -u 10001 -g jobpilot -s /bin/bash -m jobpilot

WORKDIR /app

# Copy python dependencies from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages/ /usr/local/lib/python3.12/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/

# Copy application source
COPY --chown=jobpilot:jobpilot . /app/

# Switch to non-root user
USER jobpilot:jobpilot

EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')" || exit 1

# Deterministic startup
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
