# JobPilot Environment Variables

# Local development defaults ONLY
ENVIRONMENT=development

# PostgreSQL Database Configuration (Local Development ONLY)
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_pass
POSTGRES_DB=jobpilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Machine-to-Machine Orchestration Secret (Must be >= 16 characters in production)
API_SECRET_KEY=dev_secret_key

# Provider: Adzuna (10 daily limit)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Provider: Jooble (1 daily limit, 500 lifetime limit)
JOOBLE_API_KEY=your_jooble_api_key
