# ==============================================================================
# NON-SECRET CONFIGURATION
# ==============================================================================
ENVIRONMENT=production

# Network & Domains
DOMAIN=jobpilot.example.com
ACME_EMAIL=admin@jobpilot.example.com

# Edge Security (Caddy UI Protection)
# Generate hash via: docker run --rm caddy:2.8-alpine caddy hash-password --plaintext "your_secure_password"
CADDY_ADMIN_USER=jobpilot_admin
CADDY_ADMIN_HASH=__REPLACE_WITH_CADDY_BCRYPT_HASH__

# Database Names & Service Config
POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot

N8N_DB_NAME=n8n_data
N8N_DB_USER=n8n_user

# Provider Flags
ADZUNA_ENABLED=true
JOOBLE_ENABLED=true

# Build Information
APP_COMMIT_SHA=unknown

# ==============================================================================
# VPS-ONLY SECRETS (DO NOT COMMIT REAL VALUES)
# ==============================================================================

# PostgreSQL Credentials
POSTGRES_PASSWORD=__REPLACE_WITH_SECURE_PASSWORD__

# n8n Database Credentials
N8N_DB_PASSWORD=__REPLACE_WITH_SECURE_PASSWORD__

# n8n Encryption Key (Must be stable/high-entropy)
N8N_ENCRYPTION_KEY=__REPLACE_WITH_RANDOM_SECRET__

# FastAPI Application Secret
API_SECRET_KEY=__REPLACE_WITH_API_SECRET__

# Adzuna Provider
ADZUNA_APP_ID=__REPLACE_WITH_ADZUNA_ID__
ADZUNA_APP_KEY=__REPLACE_WITH_ADZUNA_KEY__

# Jooble Provider
JOOBLE_API_KEY=__REPLACE_WITH_JOOBLE_KEY__

# Backup Secrets
BACKUP_ENCRYPTION_KEY=__REPLACE_WITH_BACKUP_KEY__
BACKUP_S3_ACCESS_KEY=__REPLACE_WITH_S3_ACCESS_KEY__
BACKUP_S3_SECRET_KEY=__REPLACE_WITH_S3_SECRET_KEY__
