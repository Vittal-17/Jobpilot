# JobPilot Environment Variables

# Local development defaults ONLY
ENVIRONMENT=development

# PostgreSQL Database Configuration (Local Development ONLY)
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LOCAL_PASSWORD
POSTGRES_DB=jobpilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Machine-to-Machine Orchestration Secret (Must be >= 16 characters in production)
API_SECRET_KEY=CHANGE_ME_TO_A_LOCAL_API_SECRET

# Provider: Adzuna
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_ENABLED=true

# Provider: Jooble (500 lifetime limit)
JOOBLE_API_KEY=your_jooble_api_key
JOOBLE_ENABLED=true

# n8n Orchestration Configuration
# DO NOT COMMUNICATE REAL SECRETS IN THIS FILE.
# N8N_ENCRYPTION_KEY must be a stable, high-entropy secret. If changed, credentials in n8n are lost.
N8N_ENCRYPTION_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY

# n8n Database Credentials (Isolating n8n from JobPilot DB)
N8N_DB_NAME=n8n_data
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=CHANGE_ME_TO_A_SECURE_N8N_DB_PASSWORD
