{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "SAMEORIGIN"

	@public_webhooks {
		path /webhook/* /webhook-test/*
	}

	handle @public_webhooks {
		reverse_proxy n8n:5678
	}

	# --- ROLLBACK BASIC AUTH ---
	# To rollback to Caddy's native basic auth:
	# 1. UNCOMMENT the `handle` block below.
	# 2. COMMENT OUT the entire `--- NEW AUTH GATEWAY ---` section (both `@auth_public` and `forward_auth` blocks).
	# handle {
	# 	basic_auth {
	# 		{$CADDY_ADMIN_USER} {$CADDY_ADMIN_HASH_B64}
	# 	}
	# 	reverse_proxy n8n:5678
	# }
	# ---------------------------

	# --- NEW AUTH GATEWAY ---
	@auth_public {
		path /login /logout /static/*
	}
	handle @auth_public {
		reverse_proxy auth-gateway:8080
	}

	handle {
		forward_auth auth-gateway:8080 {
			uri /verify
			copy_headers X-User
		}
		reverse_proxy n8n:5678
	}
	# ------------------------
}
