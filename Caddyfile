{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "SAMEORIGIN"

	@public_webhooks {
		path /webhook/* /webhook-test/*
	}
	handle @public_webhooks {
		reverse_proxy n8n:5678
	}

	handle_path /api/* {
		reverse_proxy fastapi:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}

n8n.{$DOMAIN} {
	@auth_public {
		path /login /logout
	}
	handle @auth_public {
		reverse_proxy auth-gateway:8080
	}

	handle {
		forward_auth auth-gateway:8080 {
			uri /verify
			copy_headers X-User
			header_up -Connection
			header_up -Upgrade
			header_up -Sec-WebSocket-Key
			header_up -Sec-WebSocket-Version
			header_up -Sec-WebSocket-Protocol
			header_up -Sec-WebSocket-Extensions
		}
		reverse_proxy n8n:5678
	}
}
